# Copy to .env and adjust for local dev.

# Backend base URL.
#  - iOS simulator:   http://localhost:8080
#  - physical device: http://<your-LAN-ip>:8080
#  - omit to use the production default (https://plando.imjaewoo.dev)
EXPO_PUBLIC_API_URL=http://localhost:8080

# Android Google Maps key (Apple Maps on iOS needs none). Optional in dev.
EXPO_PUBLIC_GOOGLE_MAPS_KEY=

# 카카오 지도 JavaScript 키 (WebView 지도). 카카오 콘솔에 사이트 도메인 등록 필요.
EXPO_PUBLIC_KAKAO_JS_KEY=


# 카카오톡 공유(초대)용 JavaScript 키 — 웹앱과 동일 카카오 앱 (VITE_KAKAO_JAVASCRIPT_KEY 값).
EXPO_PUBLIC_KAKAO_SHARE_JS_KEY=

# 카카오 REST API 키 — 경로 조회 API(도보/자전거/대중교통). 지도 앱과 동일 카카오 앱,
# 백엔드 todo의 kakao.maps.api-key와 같은 값.
EXPO_PUBLIC_KAKAO_REST_KEY=

# Sentry 크래시 수집 (선택)
EXPO_PUBLIC_SENTRY_DSN=

# EAS 빌드·서명용 (공개 스냅샷에서 계정 식별자를 환경변수로 뺐습니다. 로컬 실행에는 필요 없습니다)
EXPO_OWNER=
APPLE_TEAM_ID=
EAS_PROJECT_ID=
