# .env.local 로 복사해 쓰세요. VITE_ 값은 빌드 번들에 들어가는 공개 값입니다.

# 백엔드 주소 (로컬 백엔드: http://localhost:8080)
VITE_API_BASE_URL=http://localhost:8080
# 웹소켓 주소 (비우면 API 주소 기준)
VITE_WS_URL=
# 이 웹앱의 주소 (공유 링크 등에 사용)
VITE_APP_URL=http://localhost:5173

# 카카오 지도 / 카카오 JavaScript SDK 키 (카카오 개발자 콘솔에 도메인 등록 필요)
VITE_KAKAO_MAP_KEY=
VITE_KAKAO_JAVASCRIPT_KEY=

# Sentry 에러 추적 (선택)
VITE_SENTRY_DSN=
